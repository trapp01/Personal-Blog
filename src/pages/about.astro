---
import SocialList from "@/components/SocialList.astro";
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "About Matt Trapp",
	title: "About",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-6">About</h1>
	<div class="prose prose-sm prose-cactus mb-6 max-w-none">
		<p>
			Software developer based out of Calgary, Alberta, Canada. Tune in for writing and reviews on
			the stuff that's been interesting me lately.
		</p>
	</div>
	<SocialList />
</PageLayout>
