---
import type { CollectionEntry } from "astro:content";
import PostPreview from "@/components/blog/PostPreview.astro";
import MediaPreview from "@/components/media/MediaPreview.astro";
import ProjectPreview from "@/components/project/ProjectPreview.astro";
// import Note from "@/components/note/Note.astro"; // notes disabled — see note below
import { getAllMedia } from "@/data/media";
import { getAllPosts } from "@/data/post";
import { getAllProjects } from "@/data/project";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

// Home teases the most recent of each; the section headings link to the full archives.
// Reviews list as text here — the poster grid lives on /reviews/.
const MAX_POSTS = 5;
const MAX_PROJECTS = 5;
const MAX_REVIEWS = 5;

const latestPosts = (await getAllPosts())
	.sort(collectionDateSort)
	.slice(0, MAX_POSTS) as CollectionEntry<"post">[];

const latestProjects = (await getAllProjects()).sort(collectionDateSort).slice(0, MAX_PROJECTS);

const latestReviews = (await getAllMedia()).sort(collectionDateSort).slice(0, MAX_REVIEWS);

// Notes disabled for now. To re-enable: restore the getCollection + Note imports above,
// uncomment this block and the Notes <section> below, restore the nav link in
// site.config.ts and the RSS <link> in BaseHead.astro, and rename src/pages/_notes -> notes.
// const MAX_NOTES = 5;
// const allNotes = await getCollection("note");
// const latestNotes = allNotes
// 	.sort(collectionDateSort)
// 	.slice(0, MAX_NOTES) as CollectionEntry<"note">[];
---

<PageLayout meta={{ title: "Home" }}>
	<h1 class="sr-only">Matt Trapp</h1>
	<section aria-labelledby="writing-heading">
		<h2 class="title" id="writing-heading">
			<a class="hover:text-link" href="/posts/">Writing →</a>
		</h2>
		<ul class="mt-5 space-y-4 text-start">
			{
				latestPosts.map((p) => (
					<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
						<PostPreview post={p} />
					</li>
				))
			}
		</ul>
	</section>
	{
		latestProjects.length > 0 && (
			<section aria-labelledby="projects-heading" class="mt-16">
				<h2 class="title" id="projects-heading">
					<a class="hover:text-link" href="/projects/">
						Projects →
					</a>
				</h2>
				<ul class="mt-5 space-y-4 text-start">
					{latestProjects.map((item) => (
						<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
							<ProjectPreview item={item} />
						</li>
					))}
				</ul>
			</section>
		)
	}
	{
		latestReviews.length > 0 && (
			<section aria-labelledby="reviews-heading" class="mt-16">
				<h2 class="title" id="reviews-heading">
					<a class="hover:text-link" href="/reviews/">
						Reviews →
					</a>
				</h2>
				<ul class="mt-5 space-y-4 text-start">
					{latestReviews.map((item) => (
						<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
							<MediaPreview item={item} />
						</li>
					))}
				</ul>
			</section>
		)
	}
	{
		/* Notes disabled for now — see the re-enable note in the frontmatter above.
		latestNotes.length > 0 && (
			<section class="mt-4">
				<h2 class="title text-accent mb-6">
					<a href="/notes/">Notes</a>
				</h2>
				<ul class="space-y-6" role="list">
					{latestNotes.map((note) => (
						<li>
							<Note note={note} as="h3" isPreview />
						</li>
					))}
				</ul>
			</section>
		)
		*/
	}
</PageLayout>
