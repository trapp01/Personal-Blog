---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import Rating from "@/components/media/Rating.astro";
import { getCoverShape, MEDIA_TYPES } from "@/data/media";

interface Props {
	item: CollectionEntry<"media">;
	class?: string;
}

const { class: className, item } = Astro.props;
const { type, coverImage, creator, publishDate, rating, title } = item.data;
const typeMeta = MEDIA_TYPES[type];
const shape = getCoverShape(item.data);
const width = 400;
const height = Math.round(width / shape.ratio);
---

<article
	class:list={["media-card group flex h-full flex-col", className]}
	data-type={type}
	data-date={publishDate.getTime()}
	data-rating={rating}
>
	{/* grow + justify-end sits the cover on the row's baseline, so titles line up across shapes */}
	<a class="flex grow flex-col justify-end" href={`/reviews/${item.id}/`}>
		<div
			class:list={[
				"bg-global-text/5 relative mb-2 shrink-0 overflow-hidden rounded-lg",
				shape.aspect,
			]}
		>
			{
				coverImage ? (
					<Image
						alt={coverImage.alt}
						class="h-full w-full object-cover transition-transform group-hover:scale-105"
						height={height}
						src={coverImage.src}
						width={width}
					/>
				) : (
					<span class="text-muted absolute inset-0 flex items-center justify-center">
						<Icon name={typeMeta.icon} class="h-10 w-10" aria-hidden="true" />
					</span>
				)
			}
			<span
				class="bg-global-bg/80 text-muted absolute end-1.5 top-1.5 rounded px-1.5 py-0.5 text-xs font-semibold backdrop-blur"
			>
				{typeMeta.label}
			</span>
		</div>
		{/* always two lines tall so a wrapped title can't shunt the creator and rating out of line */}
		<h3 class="group-hover:text-link line-clamp-2 min-h-[2lh] leading-snug font-semibold">
			{title}
		</h3>
	</a>
	<p class="text-muted truncate text-sm">{creator}</p>
	<Rating class="mt-1" rating={rating} />
</article>
